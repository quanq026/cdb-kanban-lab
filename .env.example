# Domain cho Caddy reverse proxy va tu cap SSL (vi du: kanban.example.com, hoac localhost neu test local)
DOMAIN=

# Database (PostgreSQL 17 / Neon)
DB_HOST=
DB_PORT=5432
DB_NAME=studydb
DB_USER=app_user
DB_PASSWORD=

# DB_SSLMODE:
# - Neon: dung 'verify-full' (kem DB_SSLROOTCERT=system)
# - PostgreSQL thong thuong: 'prefer', 'require', hoac 'disable' (neu chay local / khong co TLS)
DB_SSLMODE=verify-full
DB_SSLROOTCERT=system

# Flask session signing key (sinh ngau nhien bang: openssl rand -hex 32)
APP_SECRET_KEY=
