# ==============================================================================
# CẤU HÌNH BẮT BUỘC (Chỉ cần điền 2 dòng này)
# ==============================================================================

# 1. Tên miền cho website (bắt buộc, ví dụ: kanban.yourdomain.com)
DOMAIN=

# 2. Secret key cho session (bắt buộc, sinh bằng lệnh: openssl rand -hex 32)
APP_SECRET_KEY=

# ==============================================================================
# DATABASE (Đã được cấu hình tự động với container PostgreSQL nội bộ)
# Mặc định sử dụng mật khẩu nội bộ an toàn trong docker-compose.yml.
# Muốn đổi mật khẩu DB: bỏ comment DB_PASSWORD bên dưới TRƯỚC lần `docker compose up` đầu tiên
# (vì Postgres chỉ nhận mật khẩu khi khởi tạo volume lần đầu).
# Nếu đã khởi tạo rồi, có 2 cách:
#   1) `docker compose down -v` (xoá dữ liệu) rồi up lại; hoặc
#   2) Chạy: docker exec -it cdb-db psql -U app_user -d studydb -c "ALTER USER app_user PASSWORD '<mật_khẩu_mới>'"
#      rồi cập nhật DB_PASSWORD trong .env và chạy `docker compose up -d`.
# ==============================================================================
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=studydb
# DB_USER=app_user
# DB_PASSWORD=kanban_internal_secret_2026
# DB_SSLMODE=disable
