# ==============================================================================
# CẤU HÌNH BẮT BUỘC (Chỉ cần điền 2 dòng này)
# ==============================================================================

# 1. Tên miền cho website (bắt buộc, ví dụ: kanban.yourdomain.com)
DOMAIN=

# 2. Secret key cho session (bắt buộc, sinh bằng lệnh: openssl rand -hex 32)
APP_SECRET_KEY=

